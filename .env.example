# Copy this file to .env for local development (npm run dev).
# In Netlify, set these under Site configuration > Environment variables instead.

# From Supabase dashboard > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# From console.anthropic.com > API Keys. This one is SERVER-SIDE ONLY —
# used by the Netlify function, never exposed to the browser. Do not
# prefix it with VITE_ or it would be bundled into the public client code.
ANTHROPIC_API_KEY=sk-ant-your-key-here
